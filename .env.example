HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy SUPABASE_SECRET_KEY is accepted as a server-only alias.
JOB_MODE=worker
API_TOKEN=
MAX_PAGES=24
MAX_DEPTH=3
MAX_CANDIDATES=8
MAX_SEARCH_QUERIES=6
REQUEST_TIMEOUT=20
REQUEST_DELAY=1.0
MAX_RETRIES=2
MAX_RESPONSE_BYTES=5000000
ENABLE_JAVASCRIPT=true
SEARCH_PROVIDER=ddgs
SERPER_API_KEY=
# Windows only, if Pango DLLs are not on PATH:
# WEASYPRINT_DLL_DIRECTORIES=C:/msys64/ucrt64/bin
# GOOGLE_API_KEY, AI_API_KEY and SEARCH_API_KEY are reserved; no paid API is mandatory.
