# Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Crawler Settings
MAX_PAGES=15
MAX_DEPTH=3
CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=15
REQUEST_DELAY=1.0
MAX_RETRIES=3
CRAWLER_USER_AGENT=UniversalCompetitorIntelligenceBot/1.0 (+https://github.com/competitor-intelligence; polite research crawler)

# Search Provider Configuration (Automatic Failover: Serper -> Tavily -> DuckDuckGo)
# If Serper credits end or fail, system automatically fails over to Tavily, then DuckDuckGo
SEARCH_PROVIDER=serper
SERPER_API_KEY=
TAVILY_API_KEY=

# AI Model Configuration (Optional assistance for classification & summaries)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase PostgreSQL Storage
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=

# Local SQLite Fallback Storage (Used if Supabase is offline or not configured)
SQLITE_DB_PATH=data/research.db
STORAGE_DIR=data/reports

# Google API Credentials (Optional - for Google Docs export)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
